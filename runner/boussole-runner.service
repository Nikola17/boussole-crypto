# Boussole Runner — surveillance 24/7 des alertes Boussole + envoi Telegram.
# Installation : sudo cp boussole-runner.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now boussole-runner
# Journal : journalctl -u boussole-runner -f
# Configuration : /home/ubuntu/.config/boussole/runner.json (chmod 600, voir runner/README.md).

[Unit]
Description=Boussole — surveillance des alertes (Telegram)
Documentation=https://github.com/Nikola17/boussole-crypto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Le fuseau compte : « échéance du jour » et « brief à 8 h » sont lus dans l'heure locale.
Environment=TZ=Europe/Paris
# Shell de login : Node peut être installé par l'utilisateur (~/.local/bin, nvm…) plutôt que dans /usr/bin.
ExecStart=/bin/bash -lc 'exec node /home/ubuntu/boussole-crypto/runner/boussole-runner.mjs --config /home/ubuntu/.config/boussole/runner.json'
Restart=always
RestartSec=30
# Durcir sans casser : le runner n'écrit que dans son état local.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/boussole

[Install]
WantedBy=multi-user.target

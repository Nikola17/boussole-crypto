<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F2141A22">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Boussole"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FF8B919C" />

    <TextView
        android:id="@+id/widget_market"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="—"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ouvre Boussole pour la première fois"
        android:textSize="12sp"
        android:textColor="#FFC8CDD4" />
</LinearLayout>

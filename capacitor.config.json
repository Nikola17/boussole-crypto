{
  "appId": "fr.nseguy.boussole",
  "appName": "Boussole Crypto",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "iconColor": "#3987e5"
    },
    "BackgroundRunner": {
      "label": "fr.nseguy.boussole.alerts",
      "src": "runners/alerts.js",
      "event": "checkAlerts",
      "repeat": true,
      "interval": 30,
      "autoStart": true
    }
  }
}
